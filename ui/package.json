{
  "name": "priorauth-reviewer-ui",
  "version": "0.7.0",
  "private": true,
  "description": "Reviewer UI for priorauth-agent (synthetic data only)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "gen:api": "openapi-typescript ../docs/openapi.json --output src/lib/schema.d.ts",
    "check:api": "openapi-typescript ../docs/openapi.json --output .schema-check.d.ts && diff -q src/lib/schema.d.ts .schema-check.d.ts && rm .schema-check.d.ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "next": "16.3.8",
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.2",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
